{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!coverage",
      "!pnpm-lock.yaml",
      "!**/.anyagents"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noTemplateCurlyInString": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@alchemisten/anyagents-marketplaces/*",
                  "**/packages/marketplaces/src/*"
                ],
                "message": "Import the marketplace package through its public API."
              }
            ]
          }
        }
      }
    }
  },
  "markdown": {
    "formatter": {
      "enabled": false
    }
  }
}
