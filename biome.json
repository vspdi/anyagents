{
  "$schema": "https://biomejs.dev/schemas/2.2.4/schema.json",
  "files": {
    "includes": ["**", "!dist", "!pnpm-lock.yaml", "!**/.anyagents"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noTemplateCurlyInString": "off"
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "patterns": [
              {
                "group": [
                  "@alchemisten/anyagents-marketplaces/*",
                  "**/packages/marketplaces/src/*"
                ],
                "message": "Import the marketplace package through its public API."
              }
            ]
          }
        }
      }
    }
  }
}
