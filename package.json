{
  "name": "anyagents",
  "version": "0.1.0",
  "description": "Canonical instructions, skills, and MCP configuration for Claude Code and Codex.",
  "type": "module",
  "bin": {
    "anyagents": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills",
    "docs/validation.md",
    "third-party-licenses"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "packageManager": "pnpm@10.17.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vspdi/anyagents.git"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e",
    "test:pack": "node scripts/pack-smoke.mjs",
    "prepack": "pnpm build",
    "release": "semantic-release",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@alchemisten/anyagents-marketplaces": "workspace:*",
    "@biomejs/biome": "2.6.2",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^15.0.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "semantic-release": "^25.0.9",
    "smol-toml": "^1.9.1",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^5.0.5",
    "yaml": "^2.8.1",
    "zod": "^4.6.7"
  }
}
